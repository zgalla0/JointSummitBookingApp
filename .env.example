# Copy to .env (and .env.local for secrets) and fill in as needed.
# .env* is gitignored; this file is the only one committed, as a template.

# Postgres connection string (Vercel Postgres, Neon, Render Postgres, etc.).
# There's no SQLite fallback - point this at a real Postgres instance even
# for local development.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Event date/rate config ---
# Outer limit of dates selectable at all (the hotel's group-rate extension
# may reach further than the standard block below; keep it easy to widen).
EVENT_BOOKABLE_START="2026-01-14"
EVENT_BOOKABLE_END="2026-02-05"
# The standard block shown directly in the calendar. "+ Add extra nights"
# reveals tiles between this and the bookable range above (self-paid only).
EVENT_BLOCK_START="2026-01-14"
EVENT_BLOCK_END="2026-01-29"
# Group rate (see room-types.ts for the actual per-room-type prices) only
# guaranteed inside this window.
EVENT_DISCOUNT_START="2026-01-16"
EVENT_DISCOUNT_END="2026-01-26"
# Program dates. Company-paid nights are derived from these: the night
# before All Hands + All Hands date itself are paid for everyone; the 2
# nights before that are paid only for "select" (self-attested) attendees.
EVENT_HAPPY_HOUR_DATE="2026-01-22"
EVENT_ALL_HANDS_DATE="2026-01-23"
EVENT_DINNER_DATE="2026-01-23"
# Form stops accepting automatic edits/cancellations after this date.
EVENT_LOCK_IN_DATE="2025-12-21"
# Days-out cutoff below which a cancellation skips the automatic hotel email.
EVENT_CANCEL_HOTEL_NOTICE_DAYS="10"

# Base URL used to build magic links (set to the deployed URL in production).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Stage 3/4 secrets (do not commit real values; set these in your host's
# env var settings, e.g. Vercel/Render project settings, or a local
# .env.local that stays untracked) ---
# ADMIN_PASSWORD=""
# RESEND_API_KEY=""
# "Name <address>" to send from - needs a domain verified in the Resend
# account behind RESEND_API_KEY. Defaults to Resend's shared test address
# (onboarding@resend.dev), which only delivers to that account's own
# verified email, not to real attendees.
# RESEND_FROM_EMAIL="Q1 Summit <noreply@yourdomain.com>"
# HOTEL_CONTACT_EMAIL=""
# Comma-separated - every address gets the planning-team notices.
# ADMIN_NOTIFICATION_EMAIL="name1@yourdomain.com,name2@yourdomain.com"
