# Copy to .env (and .env.local for secrets) and fill in as needed.
# .env* is gitignored; this file is the only one committed, as a template.

DATABASE_URL="file:./dev.db"

# --- Event date/rate config ---
# Bookable range shown in the date picker.
EVENT_BOOKABLE_START="2026-01-14"
EVENT_BOOKABLE_END="2026-01-29"
# $105/night group rate only guaranteed inside this window.
EVENT_DISCOUNT_START="2026-01-16"
EVENT_DISCOUNT_END="2026-01-26"
EVENT_DISCOUNT_RATE_USD="105"
# Program dates. Company-paid nights are derived from these: All Hands date
# + the night after are paid for everyone; the night before Happy Hour + the
# Happy Hour date itself are paid only for "select" (self-attested) attendees.
EVENT_HAPPY_HOUR_DATE="2026-01-21"
EVENT_ALL_HANDS_DATE="2026-01-22"
EVENT_DINNER_DATE="2026-01-22"
# Form stops accepting automatic edits/cancellations after this date.
EVENT_LOCK_IN_DATE="2025-12-21"
# Days-out cutoff below which a cancellation skips the automatic hotel email.
EVENT_CANCEL_HOTEL_NOTICE_DAYS="10"
# "+ Add extra nights" reveals this many extra self-paid-only days on either
# side of the bookable range (e.g. the hotel's possible post-event extension).
EVENT_EXTRA_NIGHTS_BUFFER_DAYS="5"

# Base URL used to build magic links (set to the deployed URL in production).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Stage 3/4 secrets (do not commit real values; set these in your host's
# env var settings, e.g. Vercel/Render project settings, or a local
# .env.local that stays untracked) ---
# ADMIN_PASSWORD=""
# RESEND_API_KEY=""
# HOTEL_CONTACT_EMAIL=""
# ADMIN_NOTIFICATION_EMAIL=""
