// Prisma schema for the Hotel Block Booking App.
// Uses Postgres (see .env.example / README for DATABASE_URL setup, e.g.
// Vercel Postgres, Neon, Render Postgres). Point DATABASE_URL at your own
// instance for local development too - there's no SQLite fallback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GuestType {
  ADULT
  CHILD
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

// Which region the attendee is based in, for PTO-coverage reporting
// (the admin calendar breaks PTO counts down by this).
enum LocationRegion {
  US_CAN_IRE
  LATAM
}

model Booking {
  id String @id @default(cuid())

  // Identity (used for the name + email duplicate check)
  firstName String
  lastName  String
  location  LocationRegion

  // False means this person isn't coming to the summit at all - the form
  // greys out everything else and they can submit right away. Defaults to
  // true since most people who fill out the form are attending.
  isAttending Boolean @default(true)

  // Hotel reservation details (separate from work name, may differ)
  reservationFirstName String
  reservationLastName  String
  nameTag              String? // name to print on the summit name tag, if different from their name
  hotelEmail           String // email used for the hotel booking
  detailsEmail         String // email for transportation / schedule / other details
  cuestaEmail          String // work email, matched against the HR roster upload on the admin Roster page


  // Event attendance. Whether an additional guest joins a given event is
  // tracked per-guest on BookingGuest instead of as a single +1 flag here.
  attendingHappyHour Boolean @default(false)
  attendingAllHands  Boolean @default(false)
  attendingDinner    Boolean @default(false)

  // Stay dates: stayStart is the first selected night, stayEnd is the
  // morning-after checkout date (one day after the last selected night)
  stayStart DateTime
  stayEnd   DateTime

  // Which Tue-Fri nights within [stayStart, stayEnd) the attendee toggled to
  // "company pays", as a JSON-encoded string[] of ISO dates (e.g.
  // ["2026-01-22", "2026-01-23"]). Nights not in this list are self-paid.
  // Only Tue-Fri nights are ever toggleable; all others are always self-paid.
  companyPaidNights String? // JSON-encoded string[] of ISO dates

  // Room type for any selected night outside the standard block (always
  // self-paid). Null when the whole stay is within the standard block.
  extraNightsRoomType String? // "DELUXE" ($105/night) or "BRISAS" ($145/night)

  // PTO days, marked via the "PTO" checkbox on Mon/Tue/Wed tiles in the
  // stay-dates picker (JSON-encoded string[] of ISO dates). This is the only
  // place PTO is captured, there is no separate PTO section on the form.
  // Tracked separately from extra self-paid nights since someone may take
  // PTO without an extra hotel night, or vice versa. Mirrors a column in an
  // internal tracker spreadsheet, not a real Mavenlink PTO submission.
  ptoDates String? // JSON-encoded string[] of ISO dates

  // Dietary / allergies: multi-select checklist plus a free-text "Other"
  dietaryOptions String? // JSON-encoded string[] of option keys
  dietaryOther   String? // free text, used only when "Other" is selected

  // Flight details, split into an arrival leg and a departure leg since
  // they may be different flights (different airline/number)
  flightArrivalAirline   String?
  flightArrivalNumber    String?
  flightArrival          DateTime?
  flightDepartureAirline String?
  flightDepartureNumber  String?
  flightDeparture        DateTime?
  flightNotes            String?

  // Free-text note for the planning team; auto-emailed to them at submit
  // time when non-empty (src/lib/email.ts sendPlanningTeamNotesEmail).
  additionalNotes String?

  // Status / admin flags
  status           BookingStatus @default(ACTIVE)
  cancelledAt      DateTime?
  cancelledByAdmin Boolean       @default(false)
  flaggedForReview Boolean       @default(false)
  flagReason       String? // free-text note on why this record needs admin attention

  // Set once an admin confirms the hotel has actually processed this
  // cancellation ("Mark as cleared" on the Hotel Export page). Until then, a
  // cancelled booking keeps showing up - highlighted red - on every Hotel
  // Export pull, even ones after it was already included in a prior send.
  hotelExportClearedAt DateTime?

  // Magic link
  magicLinkToken     String    @unique
  magicLinkExpiresAt DateTime

  guests BookingGuest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName, hotelEmail])
  @@index([magicLinkToken])
}

model BookingGuest {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  type      GuestType

  // Whether this specific guest joins the attendee at each event (only
  // asked when the attendee themselves is attending that event), plus
  // dietary restrictions for this guest specifically.
  attendingHappyHour Boolean @default(false)
  attendingDinner    Boolean @default(false)
  dietaryOptions     String? // JSON-encoded string[] of option keys
  dietaryOther       String? // free text, used only when "Other" is selected

  @@index([bookingId])
}

// One row per Booking, mirroring the exact columns of a Hotel Export row
// (see HotelExportFields in hotel-export-rows.ts) as of the last send.
// Booking itself only tracks `updatedAt`, not which fields changed or what
// they changed from, so this is the only place that makes the "What
// changed" column - and per-cell highlighting - possible: the next pull
// diffs each column against this snapshot directly, field by field, so
// any column that differs is caught with no separate list of "things that
// count as a change" to maintain by hand. Refreshed after every send;
// deleted once a booking is cancelled (nothing left to diff going
// forward).
model HotelExportSnapshot {
  bookingId String @id

  reservationFirstName String
  reservationLastName  String
  checkIn              String
  checkOut             String
  nights               Int
  nightsCompanyPaid    Int
  nightsSelfPaid       Int
  roomType             String
  totalOccupants       Int
  additionalGuestNames String
  contactEmail         String

  updatedAt DateTime @updatedAt
}

// Audit trail for the "Send to Hotel" export - who pulled hotel data and
// why, since that export leaves the building. The "View All Data" export
// is internal-only and never writes here.
model HotelExportLog {
  id        String   @id @default(cuid())
  pulledBy  String
  purpose   String
  createdAt DateTime @default(now())
}

// Simple key/value store for admin-editable static content (event info,
// Q&A, links) shown on the public form page. Populated/edited in Stage 3.
model StaticContent {
  key       String   @id
  title     String?
  body      String? // markdown / plain text
  updatedAt DateTime @updatedAt
}
