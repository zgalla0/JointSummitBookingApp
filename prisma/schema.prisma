// Prisma schema for the Hotel Block Booking App.
// Uses Postgres (see .env.example / README for DATABASE_URL setup, e.g.
// Vercel Postgres, Neon, Render Postgres). Point DATABASE_URL at your own
// instance for local development too - there's no SQLite fallback.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GuestType {
  ADULT
  CHILD
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

model Booking {
  id String @id @default(cuid())

  // Identity (used for the name + email duplicate check)
  firstName String
  lastName  String

  // Hotel reservation details (separate from work name, may differ)
  reservationFirstName String
  reservationLastName  String
  hotelEmail           String // email used for the hotel booking
  detailsEmail         String // email for transportation / schedule / other details

  // Event attendance, each with an optional +1 joining that event
  // (All Hands has no +1 option, capacity is fixed)
  attendingHappyHour Boolean @default(false)
  happyHourPlusOne   Boolean @default(false)
  attendingAllHands  Boolean @default(false)
  attendingDinner    Boolean @default(false)
  dinnerPlusOne      Boolean @default(false)

  // Stay dates: stayStart is the first selected night, stayEnd is the
  // morning-after checkout date (one day after the last selected night)
  stayStart DateTime
  stayEnd   DateTime

  // Which Tue-Fri nights within [stayStart, stayEnd) the attendee toggled to
  // "company pays", as a JSON-encoded string[] of ISO dates (e.g.
  // ["2026-01-22", "2026-01-23"]). Nights not in this list are self-paid.
  // Only Tue-Fri nights are ever toggleable; all others are always self-paid.
  companyPaidNights String? // JSON-encoded string[] of ISO dates

  // Room type for any selected night outside the standard block (always
  // self-paid). Null when the whole stay is within the standard block.
  extraNightsRoomType String? // "DELUXE" ($105/night) or "BRISAS" ($145/night)

  // PTO days, marked via the "PTO" checkbox on Mon/Tue/Wed tiles in the
  // stay-dates picker (JSON-encoded string[] of ISO dates). This is the only
  // place PTO is captured, there is no separate PTO section on the form.
  // Tracked separately from extra self-paid nights since someone may take
  // PTO without an extra hotel night, or vice versa. Mirrors a column in an
  // internal tracker spreadsheet, not a real Mavenlink PTO submission.
  ptoDates String? // JSON-encoded string[] of ISO dates

  // Dietary / allergies: multi-select checklist plus a free-text "Other"
  dietaryOptions String? // JSON-encoded string[] of option keys
  dietaryOther   String? // free text, used only when "Other" is selected

  // Flight details, split into an arrival leg and a departure leg since
  // they may be different flights (different airline/number)
  flightArrivalAirline   String?
  flightArrivalNumber    String?
  flightArrival          DateTime?
  flightDepartureAirline String?
  flightDepartureNumber  String?
  flightDeparture        DateTime?
  flightNotes            String?

  // Status / admin flags
  status           BookingStatus @default(ACTIVE)
  cancelledAt      DateTime?
  cancelledByAdmin Boolean       @default(false)
  flaggedForReview Boolean       @default(false)
  flagReason       String? // free-text note on why this record needs admin attention

  // Magic link
  magicLinkToken     String    @unique
  magicLinkExpiresAt DateTime

  guests BookingGuest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName, hotelEmail])
  @@index([magicLinkToken])
}

model BookingGuest {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  type      GuestType

  @@index([bookingId])
}

// Simple key/value store for admin-editable static content (event info,
// Q&A, links) shown on the public form page. Populated/edited in Stage 3.
model StaticContent {
  key       String   @id
  title     String?
  body      String? // markdown / plain text
  updatedAt DateTime @updatedAt
}
